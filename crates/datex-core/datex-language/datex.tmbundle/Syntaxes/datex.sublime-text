%YAML 1.2
---
name: DATEX
file_extensions:
  - dx
scope: source.datex
contexts:
  main:
    - include: comments
    - include: strings
    - include: constants
    - include: keywords
    - include: numbers
    - include: endpoints
    - include: slots
    - include: functions

  comments:
    - match: '//.*$'   # single-line comments
      scope: comment.line.double-slash.datex

    # multi-line comments
    - match: '/\*'
      scope: punctuation.definition.comment.begin.datex
      push:
        - meta_scope: comment.block.datex
        - match: '\*/'
          scope: punctuation.definition.comment.end.datex
          pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.datex
      push:
        - meta_scope: string.quoted.double.datex
        - match: '\\.'   # escape sequences
          scope: constant.character.escape.datex
        - match: '"'
          scope: punctuation.definition.string.end.datex
          pop: true

  constants:
    - match: '\b(true|false|null)\b'   # Booleans and null
      scope: constant.language.datex

  keywords:
    - match: '\b(const|let|shared|mut|function|if|else|return|print)\b'
      scope: keyword.control.datex

  numbers:
    # Floats, optionally with f32 / f64 / dbig suffix
    - match: '\b(?:[0-9]+\.[0-9]+(?:[eE][+-]?[0-9]+)?|[0-9]+[eE][+-]?[0-9]+)(?:f32|f64|dbig)?\b|\b[0-9]+(?:f32|f64|dbig)\b'
      scope: constant.numeric.float.datex

    # Integers (decimal, hex, binary), optionally with u8..u128 / ubig / i8..i128 / ibig suffix
    - match: '\b(?:0x[0-9a-fA-F]+|0b[01]+|[0-9]+)(?:u8|u16|u32|u64|u128|ubig|i8|i16|i32|i64|i128|ibig)?\b'
      scope: constant.numeric.integer.datex

  endpoints:
    - match: '@[@+]?[a-zA-Z_][a-zA-Z0-9_]*'
      scope: variable.other.endpoint.datex

  slots:
    - match: '#[a-zA-Z0-9_]+'
      scope: variable.other.slot.datex

  functions:
    - match: '\b([a-zA-Z_][a-zA-Z0-9_]*)\s*(?=\()'
      captures:
        1: entity.name.function.datex
